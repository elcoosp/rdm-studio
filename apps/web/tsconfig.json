{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@rdm-studio/ui/*": ["../../packages/ui/src/*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "lingui.config.ts", "vitest.config.ts"]
}
