    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.1.0",
    "oxlint": "^0.13.0",
    "typescript": "^5.6.0",
    "@tsdown/css": "^0.23.7",
    "tsdown": "^0.23.7"
  },
  "publishConfig": {
    "access": "restricted"
  }
