    "./tokens.css": "./dist/style.css",
    "./icons": {
      "types": "./dist/icons/EngineeringIcons.d.ts",
      "import": "./dist/icons/EngineeringIcons.js",
      "default": "./dist/icons/EngineeringIcons.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "default": "./dist/primitives/index.js"
    },
    "./interior": {
      "types": "./dist/interior/index.d.ts",
      "import": "./dist/interior/index.js",
      "default": "./dist/interior/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates/index.js",
      "default": "./dist/templates/index.js"
    },
    "./deeplinks": {
      "types": "./dist/deeplinks/index.d.ts",
      "import": "./dist/deeplinks/index.js",
      "default": "./dist/deeplinks/index.js"
    },
    "./viewport": {
      "types": "./dist/viewport/index.d.ts",
      "import": "./dist/viewport/index.js",
      "default": "./dist/viewport/index.js"
    },
    "./lib/cn": {
      "types": "./dist/lib/cn.d.ts",
      "import": "./dist/lib/cn.js",
      "default": "./dist/lib/cn.js"
    }
  },
  "scripts": {
