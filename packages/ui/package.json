    "@tanstack/react-table": "^8.20.0",
    "lucide-react": "^0.475.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.0",
    "uplot": "^1.6.0",
    "valibot": "^1.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
